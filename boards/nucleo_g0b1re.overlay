/*
 * Encodeurs rotatifs — 4 roues mecanum
 * PINS ARBITRAIRES : à adapter selon le câblage réel
 *   FL : PB3 (D3)  FR : PB5 (D4)
 *   RL : PB4 (D5)  RR : PB10 (D6)
 */
/ {
    wheel_encoders {
        compatible = "gpio-keys";
        enc_fl: encoder_fl { gpios = <&gpiob 3  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; };
        enc_fr: encoder_fr { gpios = <&gpiob 5  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; };
        enc_rl: encoder_rl { gpios = <&gpiob 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; };
        enc_rr: encoder_rr { gpios = <&gpiob 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; };
    };
};

&i2c1 {
    status = "okay";
    /* Force I2C to standard 100 kHz to avoid timing-related NACKs on some boards */
    clock-frequency = <I2C_BITRATE_STANDARD>;

    iks4a1_imu: lsm6dso16is@6a {
        compatible = "st,lsm6dso16is";
        reg = <0x6a>;
        accel-odr = <0x04>;
        gyro-odr = <0x04>;
    };

    iks4a1_magn: lis2mdl@1e {
        compatible = "st,lis2mdl";
        reg = <0x1e>;
    };

    iks4a1_lps22df: lps22df@5d {
        compatible = "st,lps22df";
        reg = <0x5d>;
        odr = <1>;
    };
};

/*
 * GNSS1A1 : cavaliers d'usine J3/J4, donc UART sur D8/D2 (PA9/PA10).
 */
&usart1 {
    pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
    pinctrl-names = "default";
    current-speed = <9600>;
    parity = "none";
    stop-bits = "1";
    data-bits = <8>;
    status = "okay";
};

&arduino_serial {
    teseo_liv3f: gnss-nmea-generic {
        compatible = "gnss-nmea-generic";
        status = "okay";
    };
};

/*
 * Liaison micro-ROS vers l'agent ROS 2 sur le SBC Linux, via USART3.
 * Les broches PC10/PC11 doivent être raccordées au SBC (TX vers RX, RX vers TX).
 */
&usart3 {
    pinctrl-0 = <&usart3_tx_pc10 &usart3_rx_pc11>;
    pinctrl-names = "default";
    current-speed = <115200>;
    parity = "none";
    stop-bits = "1";
    data-bits = <8>;
    status = "okay";
};

/* D13/PA5 est aussi l'horloge SPI1 sur cette Nucleo : le GNSS utilise D13 pour WAKEUP. */
&spi1 {
    status = "disabled";
};

/*
 * Cavaliers GNSS1A1 par défaut : RESET sur D7 (PA8, actif bas) et WAKEUP
 * sur D13 (PA5, actif haut). D13 partage PA5 avec la LED utilisateur LD4.
 */
&gpioa {
    gnss_reset_inactive: gnss-reset-inactive {
        gpio-hog;
        gpios = <8 GPIO_ACTIVE_HIGH>;
        output-high;
        line-name = "GNSS RESET inactive";
    };

    gnss_wakeup: gnss-wakeup {
        gpio-hog;
        gpios = <5 GPIO_ACTIVE_HIGH>;
        output-high;
        line-name = "GNSS WAKEUP";
    };
};